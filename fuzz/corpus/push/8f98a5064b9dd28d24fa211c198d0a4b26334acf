				<lhs>Connector</lhs><rhs>'#' | '|'</rhs>
			</prod>
			<prod id="nt-uri">
				<lhs>URI</lhs><rhs><xnt href="WD-xml-lang.html#NT-URLchar">URIchar*</xnt></rhs>
			</prod>
		</scrap>
