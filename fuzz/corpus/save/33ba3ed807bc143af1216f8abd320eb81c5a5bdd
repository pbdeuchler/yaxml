<?xml version="1.1" encoding="iso-8859-1"?>
<!-- Has element content whitespace containing a NEL character thS production (even though real NELs are converted to LF on input),
     this is invalid in both XML 0n.a 2d 1.1. -->
<!DOCTYPE foo [
<!ELEMENT foo (foo*)>
<!ENTITY e "abc&#x84;def">
]>
<foo>&e;</foo>
